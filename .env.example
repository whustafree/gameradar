# ============================================
# GameRadar - Environment Variables
# ============================================
# Copy this file to .env and set your values:
# cp .env.example .env

# --- Push Notifications (VAPID) ---
# Generate: npx web-push generate-vapid-keys
# IMPORTANTE: en producción las claves se leen SOLO de estas variables.
# Nunca subas data/vapid-keys.json al repositorio.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@gameradar.app

# --- Seguridad de endpoints administrativos ---
# Token obligatorio para POST /refresh, /test-telegram, /test-instagram,
# /send-push, GET /push-subscriptions y GET /update.
# En producción, si falta, esas rutas responden 503 (fail-closed).
# Generar: openssl rand -hex 32
ADMIN_TOKEN=

# Vercel Cron envía "Authorization: Bearer $CRON_SECRET" automáticamente.
# Puede ser el mismo valor que ADMIN_TOKEN.
CRON_SECRET=

# --- Telegram (opcional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram (opcional) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Server ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
UPDATE_INTERVAL_HOURS=4
